// Schéma de la base de données TravelPlan
// Connecté à PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  nom          String
  prenom       String
  email        String        @unique
  password     String
  role         String        @default("VOYAGEUR") // ADMIN | VOYAGEUR
  is_verified  Boolean       @default(true)
  reservations Reservation[]
  avis         Avis[]

  @@map("user")
}

model Voyage {
  id             String        @id @default(cuid())
  titre          String
  destination    String        // Nom direct de la destination, ex: "Paris, France"
  description    String
  date_de_depart DateTime
  date_de_retour DateTime
  prix           Float
  nb_total       Int
  nb_disponible  Int
  programme      String        // JSON array stringifié: '["Jour 1...", "Jour 2..."]'
  images         String        // JSON array d'URLs d'images: '["https://...", ...]'
  statut         String        @default("ACTIVE") // ACTIVE | Annulé
  reservations   Reservation[]
  avis           Avis[]

  @@map("voyage")
}

model Reservation {
  id         String    @id @default(cuid())
  date       DateTime  @default(now())
  statut     String    @default("En attente") // En attente | Confirmée | Annulée
  quantite   Int       @default(1)
  user_id    String
  voyage_id  String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  voyage     Voyage    @relation(fields: [voyage_id], references: [id], onDelete: Cascade)
  paiement   Paiement?
  avis       Avis?

  @@map("reservation")
}

model Paiement {
  id             String      @id @default(cuid())
  montant        Float
  date           DateTime    @default(now())
  statut         String      @default("Payé")
  reservation_id String      @unique
  reservation    Reservation @relation(fields: [reservation_id], references: [id], onDelete: Cascade)

  @@map("paiement")
}

model Avis {
  id             String      @id @default(cuid())
  note           Int
  commentaire    String
  publie         Boolean     @default(false)
  user_id        String
  voyage_id      String
  reservation_id String      @unique
  user           User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  voyage         Voyage      @relation(fields: [voyage_id], references: [id], onDelete: Cascade)
  reservation    Reservation @relation(fields: [reservation_id], references: [id], onDelete: Cascade)

  @@map("avis")
}

model Message {
  id      String @id @default(cuid())
  nom     String
  email   String
  sujet   String
  message String

  @@map("message")
}